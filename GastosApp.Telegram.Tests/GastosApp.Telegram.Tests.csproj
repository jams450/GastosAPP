<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../GastosApp.API/GastosApp.API.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The harness classes stay internal: the checks are an implementation detail of this
         assembly, and GastosApp.Backend.Tests invokes them without widening the public surface. -->
    <InternalsVisibleTo Include="GastosApp.Backend.Tests" />
  </ItemGroup>
</Project>
