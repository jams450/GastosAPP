# Tipo de cambio: Banxico SIE (https://www.banxico.org.mx/SieAPIRest/service/v1).
# El token es gratuito y se solicita en .../service/v1/token. Nunca se versiona uno real.
Banxico__Enabled=false
Banxico__Token=SET_FROM_ENV
# Un código de serie por divisa, tomado del catálogo de series de Banxico.
# Se dejan vacíos a propósito: un código equivocado debe fallar de forma visible en el log
# en lugar de descargar una tasa inventada. Una divisa sin serie simplemente no se sincroniza.
# MXN no aparece porque es la divisa base y no necesita tipo de cambio.
Banxico__Series__USD=
Banxico__Series__EUR=
Banxico__Series__GBP=
Banxico__Series__CAD=
Banxico__Series__JPY=
