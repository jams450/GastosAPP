{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "SET_JWT_KEY_FROM_ENV",
    "Issuer": "GastosApp",
    "Audience": "GastosAppUsers"
  },
  "ConnectionStrings": {
    "DefaultConnection": "SET_DEFAULT_CONNECTION_FROM_ENV"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:3000"
  }
}
